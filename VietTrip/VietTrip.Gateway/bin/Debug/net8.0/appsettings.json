{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "category-route": {
        "ClusterId": "category-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },

      "destination-route": {
        "ClusterId": "destination-cluster",
        "Match": {
          "Path": "/api/destinations/{**catch-all}"
        }
      },

      "tour-route": {
        "ClusterId": "tour-cluster",
        "Match": {
          "Path": "/api/tours/{**catch-all}"
        }
      },

      "tour-schedules-route": {
        "ClusterId": "tour-cluster",
        "Match": {
          "Path": "/api/TourSchedules/{**catch-all}"
        }
      },

      "itineraries-route": {
        "ClusterId": "tour-cluster",
        "Match": {
          "Path": "/api/Itineraries/{**catch-all}"
        }
      },

      "tour-images-route": {
        "ClusterId": "tour-cluster",
        "Match": {
          "Path": "/api/TourImages/{**catch-all}"
        }
      },

      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/Bookings/{**catch-all}"
        }
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/Payments/{**catch-all}"
        }
      },

      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/Media/{**catch-all}"
        }
      },

      "review-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/api/Reviews/{**catch-all}"
        }
      },

      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "https://localhost:7064/"
          }
        }
      },

      "category-cluster": {
        "Destinations": {
          "category-service": {
            "Address": "https://localhost:7286/"
          }
        }
      },

      "destination-cluster": {
        "Destinations": {
          "destination-service": {
            "Address": "https://localhost:7113/"
          }
        }
      },

      "tour-cluster": {
        "Destinations": {
          "tour-service": {
            "Address": "https://localhost:7275/"
          }
        }
      },

      "media-cluster": {
        "Destinations": {
          "media-service": {
            "Address": "https://localhost:7070/"
          }
        }
      },

      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "https://localhost:7078/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "https://localhost:7115/"
          }
        }
      },

      "review-cluster": {
        "Destinations": {
          "review-destination": {
            "Address": "https://localhost:7058"
          }
        }
      },

      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "https://localhost:7071"
          }
        }
      }
    }
  }
}